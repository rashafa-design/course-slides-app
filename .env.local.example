# Copy this file to .env.local and fill in real values.
# .env.local is never committed to GitHub (see .gitignore) — it's the only
# place secrets live, both on your machine and later in Vercel's settings.

# Supabase: project dashboard -> Connect -> App Frameworks -> Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic: console.anthropic.com -> API Keys
# Not used by the code yet (that's a later phase) but reserved here now.
ANTHROPIC_API_KEY=
